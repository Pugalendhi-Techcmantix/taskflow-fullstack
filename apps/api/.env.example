# Copy to .env and fill in. .env is git-ignored.
NODE_ENV=development
PORT=4100
# Local PostgreSQL 19 (created in pgAdmin). Replace <password>; URL-encode special characters.
DATABASE_URL="postgresql://taskflow:<password>@localhost:5433/taskflow?schema=public"
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5200
