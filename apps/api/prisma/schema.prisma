generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

/// A person who can sign in. Emails are stored trimmed and lowercased by the API.
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  /// Workspace role: admin | project_manager | developer | viewer
  roleId       String   @map("role_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  role               Role            @relation(fields: [roleId], references: [id])
  refreshTokens      RefreshToken[]
  invitesSent        Invite[]        @relation("InvitedBy")
  projectsCreated    Project[]       @relation("ProjectCreator")
  projectMemberships ProjectMember[]

  @@index([roleId])
  @@map("users")
}

/// One row per issued refresh token. Only a SHA-256 hash is stored, never the token itself.
/// Tokens rotate on every use; all tokens from one login share a familyId so a stolen,
/// re-used token can revoke the whole family.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// The four fixed workspace roles. Rows are inserted by the migration; ids are stable text keys.
model Role {
  id        String @id
  name      String @unique
  sortOrder Int    @map("sort_order")

  users       User[]
  permissions RolePermission[]
  invites     Invite[]

  @@map("roles")
}

/// Every action that can be allowed or denied, e.g. "task:move". Inserted by the migration.
model Permission {
  key       String @id
  label     String
  sortOrder Int    @map("sort_order")

  roles RolePermission[]

  @@map("permissions")
}

/// Which role may do what. Editable from the permission matrix (except the Admin role).
model RolePermission {
  roleId        String @map("role_id")
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

/// An emailed invitation. Only a hash of the link token is stored. Pending = not accepted,
/// not revoked, not expired.
model Invite {
  id          String    @id @default(uuid(7)) @db.Uuid
  email       String
  roleId      String    @map("role_id")
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  role      Role @relation(fields: [roleId], references: [id])
  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("invites")
}

/// A project. `key` (2–5 capital letters) is unique and never changes: task IDs like TF-101 use it.
model Project {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  name        String
  description String   @default("")
  /// One of the 8 palette colours (#rrggbb)
  color       String
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User?           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ProjectMember[]

  @@map("projects")
}

/// Who belongs to which project. Admins can see every project without being a member.
model ProjectMember {
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}
